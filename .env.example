# ==============================================================================
# AKD INTERIOR — PRIVATE BUSINESS MANAGEMENT CRM
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your Supabase project credentials.
# NEVER commit your actual .env file or expose the Supabase service_role key
# in client-side code.
# ==============================================================================

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Protected by Row Level Security policies)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Restrict owner access to a specific provisioned owner email address
VITE_OWNER_EMAIL=owner@akdstudio.com
